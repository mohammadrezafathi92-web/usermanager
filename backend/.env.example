SECRET_KEY=replace-with-a-long-random-string
# Default: SQLite, a single file inside the ./backend/data volume mount (so
# it survives container recreation) - fine for most installs, zero setup.
# For a high-user-count deployment you can instead point this at a
# MySQL/MariaDB server (see install.sh, which can set this up for you, or
# do it by hand and use the form below):
#   DATABASE_URL=mysql+pymysql://usermanager:PASSWORD@mariadb:3306/usermanager
# Note: backup/restore and HA sync use a mysqldump/mysql round-trip instead
# of SQLite's file-based snapshot/swap when this is a mysql:// URL - see
# services/backup.py's module docstring for the tradeoffs.
DATABASE_URL=sqlite:////app/data/usermanager.db
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-please
POLL_INTERVAL_SECONDS=30

# RADIUS server (auth+accounting for OpenVPN/L2TP on MikroTik)
RADIUS_ENABLED=true
RADIUS_BIND_HOST=0.0.0.0
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_HOSTS_REFRESH_SECONDS=60
# Public IP/host of this panel, as reachable from your router - used as the
# default value in the "push RADIUS config" button if you don't type one.
PANEL_PUBLIC_HOST=

# Error monitoring (optional - leave empty to disable completely). Get a DSN
# from your GlitchTip server (self-hosted, Sentry-compatible - what this
# deployment uses, since sentry.io is blocked from Iran) or from sentry.io:
#   -> Settings -> Projects -> your project -> Client Keys (DSN)
# Example shape: http://<key>@<host>:9000/<project-id>
# Leave SENTRY_TRACES_SAMPLE_RATE at 0 for GlitchTip - it's an error
# tracker; performance traces just add traffic it won't show you.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
