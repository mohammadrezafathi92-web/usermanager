__pycache__/
*.pyc
node_modules/
dist/
build/
.env
*.db
*.sqlite3
data/
backups/
.DS_Store
*.log
venv/
.venv/
*.zip
.vscode/
.idea/

# Ruflo local secrets and runtime data
.env.local
.env.*.local
# The whole directory, not just data/logs/sessions/ - `ruflo init` recreates
# one of these under every subfolder it touches (backend/, backend/app/,
# frontend/src/, ...), which kept showing up as untracked noise in `git
# status` no matter how many times it was cleared out.
.claude-flow/
**/.claude-flow/

# graphify's own output (knowledge-graph JSON/HTML/report) - local tooling
# output, not project source; same "shows up everywhere it ran" pattern as
# .claude-flow/ above.
graphify-out/
**/graphify-out/

# stray files that should never be committed
_sync_test.txt
root@*

# The license signing PRIVATE key (backend/scripts/license_tool.py keygen).
# This is the whole security of the licensing scheme - if it ever lands in
# this repo (which is PUBLIC), anyone can mint a valid license for any
# panel. Only the derived PUBLIC key belongs in the source tree.
.license-keys/
